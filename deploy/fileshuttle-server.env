# FileShuttle server settings, read by the systemd unit (fileshuttle-server.service) as KEY=value lines.
# Every line below is a commented-out default: remove the "#" only to change one, then
#   sudo systemctl restart fileshuttle-server
# No secrets belong in this file. The web password is set with
#   sudo -u fileshuttle-server fileshuttle-server set-password
# (it is stored hashed in the server's database, never here).

# Where the server keeps its database, settings and the trash (the unit may write only here, plus any
# ReadWritePaths= you add; see below).
#FILESHUTTLE_SERVER_DATA_DIR=/var/lib/fileshuttle-server

# Port for the web UI and API (1024-65535).
#FILESHUTTLE_SERVER_PORT=8765

# Address to listen on. LOOPBACK ONLY (127.0.0.1, 127.x.x.x or ::1): the server can move and delete files, so it
# is never exposed directly. Reach it from your other devices with Tailscale, over your tailnet only:
#   sudo tailscale serve --bg 8765        (never "tailscale funnel": that would publish it to the whole internet)
# The server refuses to start on any other address unless you ALSO set FILESHUTTLE_SERVER_ALLOW_NON_LOOPBACK=1,
# which is not recommended and not needed for tailscale serve.
#FILESHUTTLE_SERVER_HOST=127.0.0.1
#FILESHUTTLE_SERVER_ALLOW_NON_LOOPBACK=

# The built web UI (installed by the package).
#FILESHUTTLE_SERVER_WEB_DIR=/usr/lib/fileshuttle-server/web

# Where deleted files go (the freedesktop.org trash layout: files/ and info/), so Undo can bring them back.
# Default: <data dir>/Trash. Folders on another drive use that drive's own .Trash-<uid> folder instead.
#FILESHUTTLE_SERVER_TRASH_DIR=

# ---------------------------------------------------------------------------------------------------------------
# Which folders can jobs touch?
# The service runs as the unprivileged user "fileshuttle-server" with ProtectSystem=strict and
# ProtectHome=read-only. That means it can READ most things but can only WRITE inside its data folder. A job that
# moves, copies, zips or deletes files elsewhere (including anywhere under /home) fails until you allow it, and
# this file cannot do that (it only sets environment variables). Allow folders with a systemd drop-in:
#
#   sudo systemctl edit fileshuttle-server
#       [Service]
#       ReadWritePaths=/srv/inbox /mnt/data
#
# then restart the service. Two more things must be true: the "fileshuttle-server" user needs ordinary file
# permissions on those folders, and for a folder on another drive the drive's top folder must be in
# ReadWritePaths= too (deleted files are sent to a ".Trash-<uid>" folder there; the server never deletes a file
# it cannot trash, it fails that file instead).
